# Copy to server/.env (git-ignored). The server process reads only these.
# It connects as app_conn, never as the superuser.
DATABASE_URL=postgres://app_conn:app_conn_dev@127.0.0.1:54330/hoimau
# 32 random bytes, base64: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
JOURNAL_KEY=
# The outbox mailer (reset codes written to server/.outbox/mail.jsonl) starts only with
# NODE_ENV=development or NODE_ENV=test; any other value, or none, stops the start-up.
MAIL_MODE=outbox
NODE_ENV=development
# The interface the API listens on. Default 127.0.0.1 (this machine only); a server that takes
# requests from the network sets its own address, or 0.0.0.0 for every interface.
HOST=127.0.0.1
PORT=8787
