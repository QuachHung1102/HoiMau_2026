{
  "name": "hoi_mau",
  "version": "0.1.0",
  "private": true,
  "codegenConfig": {
    "name": "HoiMauNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src/shared/native",
    "android": {
      "javaPackageName": "com.hoi_mau"
    }
  },
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "preview": "vite --config tools/preview/vite.config.mjs",
    "preview:shot": "node tools/preview/shot.mjs",
    "lint": "eslint src domain server __tests__ tools *.js",
    "start": "react-native start",
    "test": "jest",
    "test:e2e": "jest -c jest.e2e.config.js --runInBand",
    "domain:test": "node --test --experimental-test-coverage --test-coverage-include=domain/**/*.ts --test-coverage-exclude=domain/**/*.test.ts --test-coverage-exclude=domain/contract/** --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 \"domain/**/*.test.ts\"",
    "domain:bundle-check": "react-native bundle --platform android --dev false --entry-file scripts/domain-bundle-entry.js --bundle-output node_modules/.cache/hoi-mau/domain.bundle",
    "demo:reverse": "node scripts/demo-reverse.mjs",
    "server:install": "npm --prefix server ci",
    "server:typecheck": "npm --prefix server run typecheck",
    "server:test": "npm --prefix server test",
    "server:dev": "npm --prefix server run dev",
    "server:perf": "npm --prefix server run perf",
    "db:verify": "npm --prefix server run db:verify",
    "db:api-check": "npm --prefix server run db:api-check",
    "db:mutation-check": "npm --prefix server run db:mutation-check",
    "db:cleanup": "npm --prefix server run db:cleanup",
    "content:count": "npm --prefix server run content:count --"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-navigation/bottom-tabs": "7.20.0",
    "@react-navigation/native": "7.5.0",
    "@react-navigation/native-stack": "7.20.0",
    "@tanstack/react-query": "5.104.1",
    "lucide-react-native": "1.55.0",
    "react": "19.2.3",
    "react-native": "0.87.1",
    "react-native-keychain": "10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.29.0",
    "react-native-svg": "15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.1",
    "@react-native/eslint-config": "0.87.1",
    "@react-native/jest-preset": "0.87.1",
    "@react-native/metro-config": "0.87.1",
    "@react-native/typescript-config": "0.87.1",
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "playwright-core": "1.64.0",
    "prettier": "2.8.8",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.4",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">= 24.8"
  }
}
